#version 450

// Sustained FMA/matmul-style compute load. Analogous to what OCCT/GpuTest's
// compute stress tests do: keep every ALU lane busy long enough to expose
// thermal throttling and power-limit behavior under load.

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Data {
    float values[];
};

layout(push_constant) uniform Push {
    uint iterations;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= values.length()) {
        return;
    }

    float a = values[idx];
    float b = fract(float(idx) * 0.6180339887);

    for (uint i = 0u; i < pc.iterations; i++) {
        a = fma(a, b, 0.0001);
        b = fma(b, a, 0.0001);
        a = a - floor(a * 0.001) * 1000.0; // keep values bounded
        b = b - floor(b * 0.001) * 1000.0;
    }

    values[idx] = a + b;
}
